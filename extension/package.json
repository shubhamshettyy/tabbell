{
  "name": "tabbell-extension",
  "description": "TabBell — watch anything on any page and get pinged the moment it changes.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "icons": "node scripts/gen-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.5",
    "sharp": "^0.35.3",
    "typescript": "^5.6.0",
    "wxt": "^0.20.0"
  }
}
